06,0.03164782,-0.09634781,0.05916065,-0.01771631,0.00694214,0.03197317,0.20239964,0.00643279,0.01847758,-0.02518066,-0.01658298,0.00876641,0.05752435,0.03133202,-0.01531941,0.00664454,0.07963214,-0.06244419,-0.01147623,0.01174382,-0.03767705,0.01577767,0.00569059,0.0201949,-0.00222867,-0.00889575,-0.05378738,0.01115072,0.11637982,0.05856093,-0.00413569,-0.02128898,-0.007503,0.04680292,-0.03215333,0.02007393,-0.0168879,-0.01903259,0.00734549,0.04037257,0.04648309,-0.0048139,-0.01561715,-0.01293525,-0.01482122,0.04964451,0.01503537,0.05642024,0.0359619],"last_embed":{"tokens":385,"hash":"w27504"}}},"last_read":{"hash":"w27504","at":1781499347174},"class_name":"SmartSource","last_import":{"mtime":1781262106550,"size":3072,"at":1781490934641,"hash":"w27504"},"blocks":{"#---frontmatter---":[1,40],"##🧭 导航":[42,48],"##🧭 导航#{1}":[43,48]},"outlinks":[{"title":"01_原始材料-外部导入","target":"01_原始材料-外部导入","line":43},{"title":"流程架构项目MOC","target":"流程架构项目MOC","line":43},{"title":"M-88_mark日常输出","target":"M-88_mark日常输出","line":43}],"metadata":{"id":"decision_framework_022","name":"五维债诊断框架 (Five-Dimensional Debt Diagnostic Framework)","layer":"A","type":"decision_framework","schema_version":"v3.0","version":"v0.9","status":"draft","created":"2026-05-21","source_cards":[],"source_documents":["governance/data_feedback/_source_raw/战略对话_Context_2026-05-20_v3.md (源头 md5: 762c259225883fe988e73c3f8a1ca6a9)","governance/data_feedback/_source_raw/GTM专题方案_2026-05-20.md (源头 md5: e26bf475e730ce17f2cab464fdfe4208)","governance/data_feedback/_source_raw/阶段2跃升完整工程计划_2026-05-20.md (源头 md5: 73ecd313685d22c769bbec997a177146)","战略文档 family (Mark 多AI+创始人编排头脑风暴产物 / 5-20) / Pipeline A Type B / §144 / 簇 D 五维债诊断 / Claude self-execution v0.9 atomic claim (Mark 'y all' 5-21) / mark_verified=false / Mark polish=替换 后 promote v1.0"],"guided_by_principles":[],"supported_by_mechanisms":[],"applicable_scopes":["阶段跃升就绪诊断","债务优先级排序","多维耦合短板识别","工程动作权重分配","阶段2全速前置许可判定"],"mark_verified":false,"mark_input_mode":"full","mark_input":{"business_framework":"五维债诊断框架: 数据债(schema层) + 代码债(实现层/含AI-native) + 流程债(业务运行层/核心形态=接口债) + 组织债(人员/方法论层) + 上下文债(贯穿层/persistent memory)。五维全 audit 才能判阶段跃升就绪。配三层耦合架构(组织AI化↕流程工程化↕数据标准化/任一短板拖累全部)。数据债 audit 是阶段2全速的前置许可证(未跑通前受速度约束)。","causal_logic":"单维度优化 → 其他维度短板拖累全部(三层耦合) → 跃升靠'感觉好了'不可靠。五维全 audit + 债务量化 → 跃升就绪可客观判定 → 阶段2全速有据。反向: 跨层强压反馈周期(合规层压到日级) → 噪音决策。","root_cause":"债务分散在 5 个不同层(schema/实现/业务/组织/贯穿) / 无统一诊断框架 → 跃升判断主观。根本是缺少跨维度统一债务诊断标尺(类比财务审计的资产负债表)。","quantitative_thresholds":"5 维度 / 数据债 audit = 前置许可证 / 元工程成本 input-based<10-15%(v2)→outcome-based交付速度趋势(v3) / 接口债 SLA 5 指标 / 反馈周期分层(运营日级/管理周级/合规月级/战略年级)","application_scenarios":"阶段跃升就绪诊断 / 债务优先级排序 / 多维耦合短板识别 / 工程动作权重分配 / 阶段2全速前置许可"},"verification_history":[{"date":"2026-05-21","by":"Claude self-execution Pipeline A 簇 D (Mark 'y all')","note":"CREATED v0.9 LLM_DRAFT / 战略文档 family 五维债诊断簇 / §43 全新 verify / mark_verified=false / status=draft / Mark polish=替换 后 promote / 溯源锚定 3 战略 md md5"}],"graph_layer":"01_原始材料-外部导入","graph_tag":"原料","graph_subdir":"M-88_mark日常输出","tags":["#原料","#日常"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"项目-流程架构/decision_framework_022_v0.9.md"},
